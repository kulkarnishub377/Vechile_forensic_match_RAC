# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Environment Variables - Copy to .env and fill with your values
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 
# SECURITY: This is a TEMPLATE file. Create a .env file with
# your ACTUAL values. Never commit .env to version control!
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ⚙️  DATABASE CREDENTIALS
# Update these to match your SQL Server
DB_SERVER=YOUR_SQL_SERVER_IP
DB_NAME=YOUR_DATABASE_NAME
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# 📁 FILE PATHS
# Update these to match your environment
IMAGE_PATH_LOCAL=YOUR_LOCAL_IMAGE_PATH
IMAGE_PATH_NETWORK=YOUR_NETWORK_IMAGE_PATH

# 🌐 API CONFIGURATION
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=1

# 🔄 REDIS CACHE
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 📊 LOGGING
LOG_LEVEL=INFO
LOG_DIR=logs

# 🔐 SECURITY
ENABLE_API_AUTH=false
API_RATE_LIMIT=100
