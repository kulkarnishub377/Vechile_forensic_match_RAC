# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# 
# SECURITY: Copy this file to .env and fill in YOUR values
# CRITICAL: NEVER commit .env to version control
# .env is in .gitignore - it's local development only
#
# For production, use CI/CD secrets (GitHub Secrets, Azure Key Vault, etc.)
#
# ==========================================

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Required: SQL Server connection parameters
MSSQL_SERVER=192.50.20.15
MSSQL_DATABASE=HTMS_EPE
MSSQL_USERNAME=admin
MSSQL_PASSWORD=your_secure_password_here
MSSQL_PORT=1433
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# ==========================================
# IMAGE PATH MAPPING (Optional)
# ==========================================
# Map local/network paths for image access
ENABLE_PATH_MAPPING=false
PATH_MAPPING_SOURCE=E:\_TrxMedia
PATH_MAPPING_TARGET=\\192.50.20.13\_TrxMedia

# ==========================================
# API CONFIGURATION
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_TIMEOUT=120

# Enable API key authentication (optional)
ENABLE_API_KEY_AUTH=false
API_KEY=your_api_key_here

# ==========================================
# CACHE CONFIGURATION (Redis)
# ==========================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==========================================
# ML MODEL BACKEND
# ==========================================
# Options: "pytorch" or "openvino" (openvino recommended for CPU)
REID_BACKEND=openvino
YOLO_BACKEND=openvino
ML_DEVICE=CPU
USE_GPU=false
GPU_ID=0

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# ==========================================
# ENVIRONMENT MODE
# ==========================================
# Options: "development", "staging", "production"
ENVIRONMENT=development
DEBUG=False

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_OCR=true
ENABLE_FAISS_LAZY_LOADING=true
ENABLE_CIRCUIT_BREAKER=true

# ==========================================
# SECURITY
# ==========================================
# For production: use HTTPS/TLS
HTTPS_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# ==========================================
# PERFORMANCE TUNING
# ==========================================
# Ingestion
INGESTION_BATCH_SIZE=16
INGESTION_WORKER_THREADS=3
INGESTION_POLL_INTERVAL=10

# FAISS Vector DB
FAISS_IVF_NLIST=100
FAISS_IVF_NPROBE=12
FAISS_AUTO_SAVE_INTERVAL=20

# ==========================================
# DATABASE CONNECTION POOL
# ==========================================
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_QUERY_TIMEOUT=30
