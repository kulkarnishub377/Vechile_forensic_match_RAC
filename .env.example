# ==========================================
# Vehicle Re-ID System - Environment Variables
# ==========================================
#
# Copy this file to .env and adjust values as needed
# .env is gitignored and safe for local development
# For production, use environment variables or CI/CD secrets
#
# ==========================================

# ==========================================
# API SERVER CONFIGURATION
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ==========================================
# MODEL CONFIGURATION
# ==========================================
# YOLO Detection
YOLO_BACKEND=pytorch
YOLO_MODEL=yolov8n.pt
YOLO_CONF_THRESHOLD=0.3
YOLO_IOU_THRESHOLD=0.4

# OSNet ReID
OSNET_MODEL=osnet_ain_x1_0
OSNET_BACKEND=pytorch
OSNET_EMBEDDING_DIM=512

# ==========================================
# PERFORMANCE SETTINGS
# ==========================================
# Enable GPU if available (auto-detected)
ENABLE_GPU=false

# OpenVINO CPU optimization (install openvino first)
USE_OPENVINO=false

# FAISS Vector Search
FAISS_USE_GPU=false
FAISS_DISTANCE_METRIC=l2
FAISS_TOP_K=50

# ==========================================
# SESSION & STORAGE (IN-MEMORY)
# ==========================================
MAX_SESSIONS=100
MAX_IMAGES_PER_SESSION=1000
MAX_SESSION_DURATION_HOURS=24
SESSION_CLEANUP_INTERVAL_MINUTES=60

# File Upload
MAX_FILE_SIZE_MB=50

# ==========================================
# MATCHING THRESHOLDS
# ==========================================
MATCH_CONFIDENCE_THRESHOLD=0.85
MATCH_CONFIDENT_LEVEL=0.92
MATCH_PROBABLE_LEVEL=0.85

# ==========================================
# PROCESSING TIMEOUTS
# ==========================================
DETECTION_TIMEOUT_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=30
SEARCH_TIMEOUT_SECONDS=10

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO

# ==========================================
# NO DATABASE CONFIGURATION NEEDED
# ==========================================
# This system is completely in-memory:
# - No SQL Server or PostgreSQL
# - No Redis cache required
# - No persistent storage
# - Session-based temporary storage only
# Perfect for testing and real-time matching!
